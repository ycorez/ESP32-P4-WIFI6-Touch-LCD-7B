# ESP32-P4 rev 1.3 test profile (IDF minimum revision granularity: 1.0).
# Load after sdkconfig.defaults; pre-v3 silicon requires its own build directory.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
# CONFIG_ESP32P4_REV_MIN_300 is not set
# CONFIG_ESP32P4_REV_MIN_301 is not set
# CONFIG_SPIRAM_SPEED_250M is not set
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_SPEED=200
CONFIG_BOOTLOADER_LOG_LEVEL_ERROR=y
CONFIG_BOOTLOADER_LOG_LEVEL=1
